APP_NAME=NEXORA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated browser origins allowed to call the protected API in production.
# Keep this aligned with the deployed Vercel/custom frontend domains.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local development uses the local Supabase project only. Do not point this file
# at the production project.
DB_CONNECTION=pgsql
DB_HOST=db.xmrhdnryxfnkvixidotp.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
# Alternatively, use the full local connection string. Laravel reads DB_URL.
# DB_URL=postgresql://postgres:YOUR_LOCAL_DATABASE_PASSWORD@db.xmrhdnryxfnkvixidotp.supabase.co:5432/postgres?sslmode=require

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="hello@nexora.local"
MAIL_FROM_NAME="NEXORA"

SUPABASE_URL=https://xmrhdnryxfnkvixidotp.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY is retained only for legacy clients; use the publishable key above.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
